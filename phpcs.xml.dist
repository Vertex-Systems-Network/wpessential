<?xml version="1.0"?>
<ruleset name="WPEssential">
    <description>WPEssential production PHP coding standard (ADR-0223 profile).</description>

    <arg name="basepath" value="." />
    <arg name="extensions" value="php" />
    <arg name="parallel" value="4" />
    <arg value="ps" />

    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils" />

    <file>wpessential.php</file>
    <file>frameworks</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- ADR-0223: errors gate CI; warnings (line length, advisory API hints) are reported, not blocking. -->
    <config name="ignore_warnings_on_exit" value="1" />

    <!--
        ADR-0223: WordPress formatting, security, database, i18n and WordPress API
        rules stay enforced. Only sniffs that contradict the ADR-0214 PSR-4 / PHP 8.2
        object-oriented architecture (or that rewrite runtime values) are excluded.
    -->
    <rule ref="WordPress">
        <!-- ADR-0214 deliberately adopts PSR-4 class files under frameworks/. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />

        <!-- Published camelCase PHP APIs, promoted properties and DTO fields are ABI. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName" />
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid" />
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames" />

        <!-- PHP 8.2 short arrays are the established project syntax. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax" />

        <!-- Its fixer rewrites string literals such as service ids; never auto-change runtime values. -->
        <exclude name="WordPress.WP.CapitalPDangit" />

        <!-- Strict typed comparisons are used; Yoda order adds churn without safety value. -->
        <exclude name="WordPress.PHP.YodaConditions" />

        <!-- Native types are the contract; docblock completeness is not a merge gate. -->
        <exclude name="Squiz.Commenting.FileComment" />
        <exclude name="Squiz.Commenting.ClassComment.Missing" />
        <exclude name="Squiz.Commenting.FunctionComment" />
        <exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing" />
        <exclude name="Squiz.Commenting.VariableComment.Missing" />
        <exclude name="Generic.Commenting.DocComment.MissingShort" />

        <!-- Spaceship comparator chaining ( a <=> b ) ?: ( c <=> d ) is the sort idiom used. -->
        <exclude name="Universal.Operators.DisallowShortTernary" />

        <!-- Commented empty catch blocks are allowed; Squiz.Commenting.EmptyCatchComment still requires the comment. -->
        <exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedCatch" />

        <!-- Internal exception messages are never rendered as HTML by the platform. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped" />
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120" />
            <property name="absoluteLineLimit" value="0" />
        </properties>
    </rule>
</ruleset>
