      "@test:smoke:options-bank-query-review",
      "@test:smoke:options-bank-market-audit",
      "@test:smoke:options-bank-review",
      "@test:smoke:options-bank-status-native-audit",
      "@test:smoke:options-bank-status-market-audit",
      "@test:smoke:options-bank-status-review",
      "@test:smoke:options-bank-tables",
      "@test:smoke:options-bank-tables-native-audit",
      "@test:smoke:options-bank-tables-market-audit",
      "@test:smoke:options-bank-tables-review",
      "@test:smoke:options-bank-columns-native-audit",
      "@test:smoke:options-bank-columns-market-audit",
      "@test:smoke:options-bank-columns-review",
      "@test:smoke:dashboard-widgets-native-audit",
      "@test:smoke:dashboard-widgets-market-audit",
      "@test:smoke:dashboard-widgets-review",
      "@test:smoke:option-contracts",
      "@test:smoke:option-contract-relations",
      "@test:smoke:option-contract-columns",
      "@test:smoke:option-contract-columns-ux",
      "@test:smoke:option-contract-admin-menu-ux",
      "@test:smoke:option-contract-settings-ux",
      "@test:smoke:option-contract-dashboard-ux",
      "@test:smoke:option-contract-profiles-ux",
      "@test:smoke:option-contract-membership-ux",
      "@test:smoke:option-contract-builder-widgets-ux",
      "@test:smoke:option-contract-forms-workflows-ux",
      "@test:smoke:option-contract-cron-ux",
      "@test:smoke:option-contract-notifications-ux",
      "@test:smoke:option-contract-emails-ux",
      "@test:smoke:option-contract-chat-ux"
    ],
    "quality:php": [
      "@quality:phpcs",
      "@quality:phpstan",
      "@test:unit"
    ],
    "fast": [
      "@architecture:validate",
      "@engineering:validate",
      "@test:smoke"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
