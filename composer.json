    "test:smoke:option-contract-settings-ux": "php tests/Smoke/option-contract-settings-ux-contract.php",
    "test:smoke:option-contract-dashboard-ux": "php tests/Smoke/option-contract-dashboard-ux-contract.php",
    "test:smoke:option-contract-profiles-ux": "php tests/Smoke/option-contract-profiles-ux-contract.php",
    "test:smoke:option-contract-membership-ux": "php tests/Smoke/option-contract-membership-ux-contract.php",
    "test:smoke:option-contract-builder-widgets-ux": "php tests/Smoke/option-contract-builder-widgets-ux-contract.php",
    "test:smoke:option-contract-forms-workflows-ux": "php tests/Smoke/option-contract-forms-workflows-ux-contract.php",
    "test:smoke:option-contract-cron-ux": "php tests/Smoke/option-contract-cron-ux-contract.php",
    "test:smoke:option-contract-notifications-ux": "php tests/Smoke/option-contract-notifications-ux-contract.php",
    "test:smoke:option-contract-emails-ux": "php tests/Smoke/option-contract-emails-ux-contract.php",
    "test:smoke:option-contract-chat-ux": "php tests/Smoke/option-contract-chat-ux-contract.php",
    "test:integration:compiled-registration-mysql": "php tests/Integration/compiled-registration-mysql.php",
    "test:smoke": [
      "@test:smoke:kernel",
      "@test:smoke:platform-core",
      "@test:smoke:data-source-contract",
      "@test:smoke:cache-contract",
      "@test:smoke:platform-admin-bootstrap",
      "@test:smoke:audit-jobs",
      "@test:smoke:action-scheduler-probe",
      "@test:smoke:vault-assets-integrations",
      "@test:smoke:persistence-migrations",
      "@test:smoke:wordpress-abilities-bridge",
      "@test:smoke:engineering-contracts",
      "@test:smoke:compiled-registration-persistence",
      "@test:smoke:compiled-registration-scale",
      "@test:smoke:options-bank",
      "@test:smoke:options-bank-progress",
      "@test:smoke:options-bank-native-audit",
      "@test:smoke:options-bank-relations-native-audit",
