    "test:smoke:options-bank-columns-review": "php tests/Smoke/options-bank-columns-review-contract.php",
    "test:smoke:dashboard-widgets-native-audit": "php tests/Smoke/dashboard-widgets-native-audit-contract.php",
    "test:smoke:dashboard-widgets-market-audit": "php tests/Smoke/dashboard-widgets-market-audit-contract.php",
    "test:smoke:dashboard-widgets-review": "php tests/Smoke/dashboard-widgets-review-contract.php",
