			"panel": "content"
		},
		"link": {
			"type": "url",
			"label": "Link",
			"default": "",
			"panel": "content"
		},
		"key": {
			"type": "text",
			"label": "Version (change to show again)",
			"default": "1",
			"panel": "content"
		}
	}
}