{
	"name": "notification-bar",
	"title": "Notification Bar (WPEssential)",
	"category": "content",
	"description": "Dismissible announcement strip (sale, launch, notice) with an optional link; stays closed for the visitor once dismissed.",
	"icon": "star-filled",
	"elementor_icon": "eicon-star",
	"keywords": [
		"notification",
		"announcement",
		"top bar",
		"banner"
