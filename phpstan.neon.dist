includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - wpessential.php
        - frameworks
    tmpDir: var/phpstan
    reportUnmatchedIgnoredErrors: true
    # ADR-0223: fail-closed runtime guards re-check PHPDoc-only types on untrusted WordPress input.
    treatPhpDocTypesAsCertain: false
