{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpessential.local/schema/options-bank.json",
  "title": "WPEssential Master Options & Possibilities Bank Surface",
  "description": "Discovery/product-knowledge schema. It intentionally does not duplicate the implementation-grade Atomic Option Contract schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bank_version", "surface", "snapshot", "status", "records", "coverage"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "bank_version": {"type": "string", "const": "v1"},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 56},
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "native_sources", "market_sources"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "native_sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "market_sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "status": {
      "enum": ["BANK_SURFACE_SEEDED", "BANK_MARKET_RESEARCHED", "BANK_CLASSIFIED", "BANK_REVIEWED"]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "unreviewed", "adopted_or_classified"],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "unreviewed": {"type": "integer", "minimum": 0},
        "adopted_or_classified": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "url", "verified"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["wordpress_core", "wordpress_handbook", "official_competitor", "official_provider", "repository_source", "standard"]
        },
        "url": {"type": "string", "format": "uri"},
        "verified": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "snapshot_date", "research_state"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "capability": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "snapshot_date": {"type": "string", "format": "date"},
        "research_state": {
          "enum": ["UNVERIFIED", "PRIMARY_SOURCE_VERIFIED", "MULTI_SOURCE_VERIFIED", "STALE_REVIEW_REQUIRED"]
        }
      }
    },
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "key", "internal"],
      "properties": {
        "api": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "internal": {"type": "boolean"},
        "since": {"type": ["string", "null"]}
      }
    },
    "riskHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "security": {"enum": ["normal", "privileged", "expert", "provider_only", "internal", "prohibited", "unknown"]},
        "performance": {"enum": ["cheap", "normal", "moderate", "expensive", "high_risk", "not_applicable", "unknown"]},
        "migration": {"enum": ["none", "low", "medium", "high", "destructive", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feature_group",
        "option_path",
        "label",
        "classification",
        "hard_soft",
        "horizon",
        "requiredness",
        "market_prevalence",
        "adoption",
        "priority",
        "value_type",
        "default_behavior",
        "ux_tier",
        "research_state"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "parent_id": {"type": ["string", "null"]},
        "feature_group": {"type": "string", "minLength": 1},
        "option_path": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "classification": {
          "enum": [
            "NATIVE_HARD",
            "WPE_HARD",
            "SOFT_NATIVE",
            "PROVIDER_SOFT",
            "COMPATIBILITY",
            "EXPERT",
            "EXPERIMENTAL",
            "DEFERRED",
            "REJECTED_UNSAFE",
            "WPE_EXCEED"
          ]
        },
        "hard_soft": {"enum": ["HARD", "SOFT", "HYBRID"]},
        "horizon": {"enum": ["CURRENT_NATIVE", "CURRENT_MARKET", "WPE_FUTURE"]},
        "requiredness": {
          "enum": ["REQUIRED_CREATE", "REQUIRED_PUBLISH", "OPTIONAL", "CONDITIONAL", "COMPUTED", "PROVIDER_REQUIRED"]
        },
        "market_prevalence": {"enum": ["COMMON", "SPECIALIST", "NICHE", "EMERGING", "UNKNOWN"]},
        "adoption": {
          "enum": ["UNREVIEWED", "MUST_HAVE", "PARITY", "COMPETITIVE", "WPE_EXCEED", "PROVIDER", "EXPERT_ONLY", "LATER", "REJECT"]
        },
        "priority": {
          "enum": ["P0_NATIVE", "P0_PARITY", "P1_CORE", "P1_EXCEED", "P2_COMPETITIVE", "P3_LATER", "NOT_SCHEDULED"]
        },
        "native_source": {"type": ["object", "null"], "oneOf": [{"$ref": "#/$defs/nativeSource"}, {"type": "null"}]},
        "value_type": {"type": "string", "minLength": 1},
        "allowed_values": {"type": ["array", "null"], "items": {}},
        "default_behavior": {
          "enum": ["wordpress_default", "inherited", "wpe_default", "computed", "provider_default", "none", "unknown"]
        },
        "inherits_from": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "ux_tier": {"enum": ["Essential", "Advanced", "Expert", "Provider", "System"]},
        "suggested_control": {"type": "string"},
        "progressive_disclosure": {"type": "string"},
        "risk_hints": {"$ref": "#/$defs/riskHints"},
        "portability_hint": {"enum": ["portable", "environment_sensitive", "secret", "runtime_only", "unknown"]},
        "compatibility_adapters": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "research_state": {
          "enum": ["UNVERIFIED", "PRIMARY_SOURCE_VERIFIED", "MULTI_SOURCE_VERIFIED", "STALE_REVIEW_REQUIRED"]
        },
        "wpe_exceed_opportunity": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
