{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpessential.local/schema/options-bank-native-audit.json",
  "title": "WPEssential Options Bank Native Surface Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bank_version", "surface", "snapshot", "status", "items", "coverage"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "bank_version": {"type": "string", "const": "v1"},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 56},
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "wordpress_target", "sources"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "wordpress_target": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"}
            }
          }
        }
      }
    },
    "status": {"enum": ["NATIVE_AUDIT_IN_PROGRESS", "NATIVE_AUDITED"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "api", "member", "disposition", "evidence_url", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "api": {"type": "string", "minLength": 1},
          "member": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["BANK_RECORD", "PROVIDER_MAPPING", "SYSTEM_RUNTIME", "OUT_OF_SURFACE", "LEGACY_COMPATIBILITY", "CORE_INTERNAL", "UNRESOLVED"]},
          "bank_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "owner_surface": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "evidence_url": {"type": "string", "format": "uri"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "bank_record", "provider_mapping", "system_runtime", "out_of_surface", "legacy_compatibility", "core_internal", "unresolved"],
      "properties": {
        "items": {"type": "integer", "minimum": 0},
        "bank_record": {"type": "integer", "minimum": 0},
        "provider_mapping": {"type": "integer", "minimum": 0},
        "system_runtime": {"type": "integer", "minimum": 0},
        "out_of_surface": {"type": "integer", "minimum": 0},
        "legacy_compatibility": {"type": "integer", "minimum": 0},
        "core_internal": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    }
  }
}
