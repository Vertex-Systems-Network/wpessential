{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpessential.local/schema/options-bank-market-audit.json",
  "title": "WPEssential Options Bank Market Provider Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_version",
    "surface",
    "snapshot",
    "status",
    "required_families",
    "primary_providers",
    "specialist_providers",
    "extra_dispositions",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bank_version": {
      "type": "string",
      "const": "v1"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 56
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "notes"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "MARKET_AUDIT_IN_PROGRESS",
        "MARKET_AUDITED"
      ]
    },
    "required_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_]*$"
      }
    },
    "primary_providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "evidence",
          "family_map",
          "non_applicable_families"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "family_map": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "non_applicable_families": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "specialist_providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "evidence",
          "bank_record_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "bank_record_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "extra_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "disposition",
          "evidence_url",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "OUT_OF_SURFACE",
              "IMPLEMENTATION_PATTERN",
              "DEFERRED_WITH_REASON",
              "REJECTED_UNSAFE",
              "UNRESOLVED"
            ]
          },
          "owner_surface": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_providers",
        "specialist_providers",
        "family_mappings",
        "non_applicable_family_cells",
        "bank_record_references",
        "extra_dispositions",
        "unresolved"
      ],
      "properties": {
        "primary_providers": {
          "type": "integer",
          "minimum": 0
        },
        "specialist_providers": {
          "type": "integer",
          "minimum": 0
        },
        "family_mappings": {
          "type": "integer",
          "minimum": 0
        },
        "non_applicable_family_cells": {
          "type": "integer",
          "minimum": 0
        },
        "bank_record_references": {
          "type": "integer",
          "minimum": 0
        },
        "extra_dispositions": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
