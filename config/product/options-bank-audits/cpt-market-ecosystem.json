.relationships.taxonomies","cpt.supports.custom_fields"]}],"extra_dispositions":[{"id":"acf.field_group_linking","provider":"acf","disposition":"OUT_OF_SURFACE","owner_surface":"fields","evidence_url":"https://www.advancedcustomfields.com/resources/registering-a-custom-post-type/","notes":"Linking or creating field groups after CPT creation is Fields-owned; CPT only exposes native editor support/integration references."},{"id":"acf.ability_ai_access","provider":"acf","disposition":"IMPLEMENTATION_PATTERN","evidence_url":"https://www.advancedcustomfields.com/resources/abilities-api/","notes":"ACF exposes post-type management and content operations through Abilities/AI. WPE should expose CPT mutation through its canonical owner Ability and optional AI policy, never a separate AI-owned definition store."},{"id":"meta_box.reorder_posts","provider":"meta_box","disposition":"OUT_OF_SURFACE","owner_surface":"content-order","evidence_url":"https://docs.metabox.io/extensions/mb-custom-post-type/","notes":"Meta Box Re-Order Posts is sequence/order behavior owned by Content Order, not CPT definition semantics."},{"id":"meta_box.status_toggle_column","provider":"meta_box","disposition":"OUT_OF_SURFACE","owner_surface":"status","evidence_url":"https://docs.metabox.io/extensions/mb-custom-post-type/","notes":"Quick published/draft status toggling is Status-owned runtime behavior, not a CPT registration option."},{"id":"meta_box.php_code_export","provider":"meta_box","disposition":"IMPLEMENTATION_PATTERN","evidence_url":"https://docs.metabox.io/extensions/mb-custom-post-type/","notes":"Generated PHP is an export/developer convenience. WPE may provide read-only declarative/effective previews but must not accept arbitrary executable PHP as canonical configuration."},{"id":"jetengine.meta_fields","provider":"jetengine","disposition":"OUT_OF_SURFACE","owner_surface":"fields","evidence_url":"https://crocoblock.com/knowledge-base/features/custom-post-type-overview/","notes":"JetEngine meta fields and custom meta storage are field/schema/storage concerns owned by Fields; they do not expand CPT semantic ownership."},{"id":"jetengine.admin_columns_filters","provider":"jetengine","disposition":"OUT_OF_SURFACE","owner_surface":"columns","evidence_url":"https://crocoblock.com/knowledge-base/features/custom-post-type-overview/","notes":"JetEngine admin columns and admin filters belong to the canonical Admin Columns surface."},{"id":"jetengine.listing_archive_templates","provider":"jetengine","disposition":"OUT_OF_SURFACE","owner_surface":"listings","evidence_url":"https://crocoblock.com/knowledge-base/plugins/jetengine/","notes":"Listing, single and archive rendering/template builders belong to Listings/rendering surfaces, not CPT definitions."},{"id":"jetengine.import_export","provider":"jetengine","disposition":"OUT_OF_SURFACE","owner_surface":"import-export","evidence_url":"https://crocoblock.com/knowledge-base/plugins/jetengine/","notes":"Definition/package import/export orchestration belongs to the Import/Export surface; CPT remains canonical mutation owner for its definitions."},{"id":"acpt.role_permissions","provider":"acpt","disposition":"OUT_OF_SURFACE","owner_surface":"roles","evidence_url":"https://docs.acpt.io/permissions-manager/custom-post-types-permissions","notes":"Assigning CPT capabilities to user roles is Roles-owned. CPT owns capability naming/mapping semantics only."},{"id":"acpt.custom_api","provider":"acpt","disposition":"IMPLEMENTATION_PATTERN","evidence_url":"https://docs.acpt.io/tools/custom-apis","notes":"Provider APIs that manage CPT definitions are an integration pattern. WPE REST/AI/CLI entrypoints must invoke the same canonical CPT Ability/Policy mutation path."},{"id":"cpt_ui.hooks_missing_params","provider":"cpt_ui","disposition":"IMPLEMENTATION_PATTERN","evidence_url":"https://docs.pluginize.com/tutorials/custom-post-type-ui/","notes":"CPT UI documents hooks for missing registration parameters. WPE instead keeps an API-drift audit and typed provider extension points; hooks do not justify count-only Bank records."},{"id":"market.arbitrary_executable_inputs","provider":"acf_meta_box","disposition":"REJECTED_UNSAFE","evidence_url":"https://www.advancedcustomfields.com/resources/registering-a-custom-post-type/","notes":"Market/native controller and callback customization does not authorize arbitrary admin-entered PHP/callback execution. WPE accepts only registered/allowlisted provider identities for executable extension points."},{"id":"toolset.fields","provider":"toolset","disposition":"OUT_OF_SURFACE","owner_surface":"fields","evidence_url":"https://toolset.com/home/types-manage-post-types-taxonomy-and-custom-fields/","notes":"Toolset custom fields are Fields-owned; their presence beside CPT creation does not expand CPT semantic ownership."},{"id":"toolset.relationships","provider":"toolset","disposition":"OUT_OF_SURFACE","owner_surface":"relations","evidence_url":"https://toolset.com/home/types-manage-post-types-taxonomy-and-custom-fields/","notes":"Toolset parent/child and many-to-many post relationships are Relations-owned persistent-edge semantics."},{"id":"toolset.frontend_templates","provider":"toolset","disposition":"OUT_OF_SURFACE","owner_surface":"listings","evidence_url":"https://toolset.com/home/toolset-components/","notes":"Toolset Blocks templates, archives and lists are rendering concerns owned outside CPT."},{"id":"toolset.search_queries","provider":"toolset","disposition":"OUT_OF_SURFACE","owner_surface":"query","evidence_url":"https://toolset.com/home/toolset-components/","notes":"Toolset custom searches/query retrieval are Query-owned and do not belong to CPT definitions."}],"coverage":{"primary_providers":5,"specialist_providers":1,"family_mappings":52,"non_applicable_family_cells":3,"bank_record_references":190,"extra_dispositions":17,"unresolved":0}}