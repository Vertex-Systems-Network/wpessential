ector.rate.response","protector.rule.response.retry-after"]},{"id":"nist_800_63b","name":"NIST SP 800-63B","evidence":["https://pages.nist.gov/800-63-4/sp800-63b.html"],"bank_record_ids":["protector.login.limit.thresholds","protector.unsafe.permanent-lockout"]}],"extra_dispositions":[{"id":"protector.forwarded_ip_trust","provider":"llar","disposition":"REJECTED_UNSAFE","evidence_url":"https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/X-Forwarded-For","notes":"Selecting X-Forwarded-For (or another forwarded header) as the client-IP source without a trusted-proxy CIDR list lets clients spoof their IP; WPE reads forwarded headers only from configured trusted proxies (protector.unsafe.trust-xff, protector.ip.trusted-proxies)."},{"id":"protector.permanent_ip_ban","provider":"aios","disposition":"REJECTED_UNSAFE","evidence_url":"https://wordpress.org/plugins/all-in-one-wp-security-and-firewall/","notes":"Permanent or indefinitely escalating automatic lockouts without a documented recovery path are rejected; WPE uses bounded temporary blocks plus recovery (protector.unsafe.permanent-lockout, protector.recovery.safe-mode-constant)."},{"id":"protector.hidden_login_as_security","provider":"wps_hide_login","disposition":"REJECTED_UNSAFE","evidence_url":"https://wordpress.org/plugins/wps-hide-login/","notes":"A renamed login URL is accepted only as noise reduction, never as authentication or protection (protector.unsafe.obscurity-as-auth, protector.login-alias.enable)."},{"id":"protector.blanket_rest_disable","provider":"disable_rest_api","disposition":"REJECTED_UNSAFE","evidence_url":"https://wordpress.org/plugins/disable-json-api/","notes":"Disabling REST wholesale is rejected as a default; WPE offers outer per-route deny with dependency impact preview (protector.unsafe.disable-rest-default, protector.rest.impact-preview)."},{"id":"protector.sensitive_logging","provider":"owasp_logging","disposition":"REJECTED_UNSAFE","evidence_url":"https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html","notes":"Logging submitted passwords, cookies, auth headers or tokens (e.g. failed-login password capture) is rejected (protector.unsafe.log-secrets, protector.logs.redaction)."},{"id":"protector.default_geo_lookup","provider":"wordfence","disposition":"DEFERRED_WITH_REASON","evidence_url":"https://wordpress.org/plugins/wordfence/","notes":"Country blocking relying on IP geolocation is deferred to an explicit provider integration; no third-party IP lookup by default (protector.deferred.geo, protector.unsafe.third-party-ip-lookup)."},{"id":"protector.auto_hsts_preload","provider":"hstspreload","disposition":"REJECTED_UNSAFE","evidence_url":"https://hstspreload.org/","notes":"One-click HSTS preload or strict CSP enforcement is rejected; HSTS is opt-in with warnings and CSP starts Report-Only (protector.unsafe.auto-hsts-csp, protector.headers.csp)."}],"coverage":{"primary_providers":4,"specialist_providers":18,"family_mappings":20,"non_applicable_family_cells":0,"bank_record_references":149,"extra_dispositions":7,"unresolved":0}}
