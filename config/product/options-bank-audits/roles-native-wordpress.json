ite.site_roles","roles.multisite.network_context"]},{"id":"roles.native.wp_roles.add_role","api":"WP_Roles::add_role","member":"role, display_name, capabilities","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_roles/add_role/","notes":"Native role creation defines key, display name and a boolean capability map.","bank_record_ids":["roles.role.key","roles.role.display_name","roles.operation.create","roles.capability.state"]},{"id":"roles.native.wp_roles.remove_role","api":"WP_Roles::remove_role","member":"role removal","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_roles/","notes":"Native deletion exists but WPE requires impact/remap and anti-lockout policy before any future runtime execution.","bank_record_ids":["roles.operation.delete_policy","roles.operation.delete_replacement","roles.unsafe.silent_destructive_delete"]},{"id":"roles.native.wp_role.bool_caps","api":"WP_Role","member":"capabilities bool[]","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_role/","notes":"Capability entries preserve boolean grants; false is distinct from an absent key.","bank_record_ids":["roles.capability.state","roles.capability.explicit_deny"]},{"id":"roles.native.wp_role.add_cap","api":"WP_Role::add_cap","member":"grant=true|false","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_role/add_cap/","notes":"Native API persists both positive grants and explicit false values.","bank_record_ids":["roles.capability.grant","roles.capability.explicit_deny"]},{"id":"roles.native.wp_role.remove_cap","api":"WP_Role::remove_cap","member":"unset capability entry","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_role/remove_cap/","notes":"Removing an entry returns the role to absent state rather than persisting false.","bank_record_ids":["roles.capability.remove_entry","roles.capability.state"]},{"id":"roles.native.wp_user.multiple_roles","api":"WP_User::add_role","member":"roles / caps merge","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_user/add_role/","notes":"A user can carry multiple roles; role impact cannot assume one role per user.","bank_record_ids":["roles.user.multiple_roles","roles.assignment.individual"]},{"id":"roles.native.wp_user.remove_role","api":"WP_User::remove_role","member":"remove one assigned role","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_user/remove_role/","notes":"Native user-role removal preserves other roles.","bank_record_ids":["roles.assignment.remove","roles.user.multiple_roles"]},{"id":"roles.native.wp_user.set_role","api":"WP_User::set_role","member":"replace previous roles","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_user/set_role/","notes":"set_role removes prior roles before assigning the new role, so replace semantics must be explicit.","bank_record_ids":["roles.assignment.replace"]},{"id":"roles.native.wp_user.role_caps","api":"WP_User::get_role_caps","member":"merge roles and individual capabilities","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/classes/wp_user/","notes":"Effective primitive capability truth merges role capabilities with individual user capability entries.","bank_record_ids":["roles.user.individual_caps","roles.capability.effective_preview","roles.diagnostics.effective_explain"]},{"id":"roles.native.map_meta_cap","api":"map_meta_cap","member":"contextual meta-capability mapping","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/map_meta_cap/","notes":"Meta capabilities require user and object context and resolve to primitive requirements.","bank_record_ids":["roles.capability.primitive_meta_class","roles.capability.meta_context","roles.diagnostics.permission_simulator","roles.diagnostics.effective_explain"]},{"id":"roles.native.current_user_can","api":"current_user_can","member":"capability check and super-admin behavior","disposition":"SYSTEM_RUNTIME","evidence_url":"https://developer.wordpress.org/reference/functions/current_user_can/","notes":"Runtime authorization remains Policy/capability based; role-name checks are discouraged."},{"id":"roles.native.super_admin","api":"is_super_admin","member":"multisite network authority","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/is_super_admin/","notes":"Super Admin is special network authority and is not modeled as an ordinary site role checkbox.","bank_record_ids":["roles.safety.super_admin","roles.unsafe.super_admin_checkbox"]},{"id":"roles.native.editable_roles","api":"get_editable_roles","member":"editable_roles filtered role set","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/get_editable_roles/","notes":"The set of roles an actor may edit or assign is filterable and actor-sensitive.","bank_record_ids":["roles.role.editable_state","roles.safety.target_role_policy","roles.diagnostics.caveats"]},{"id":"roles.native.default_role","api":"Roles and Capabilities","member":"default_role option","disposition":"BANK_RECORD","evidence_url":"https://wordpress.org/documentation/article/roles-and-capabilities/","notes":"The default role is site configuration and deletion workflows must account for it.","bank_record_ids":["roles.role.default_state","roles.operation.delete_policy"]},{"id":"roles.native.cpt_caps","api":"register_post_type / WP_Post_Type","member":"generated post-type capability families","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/register_post_type/","notes":"CPT-generated capabilities are registry inputs; CPT definition ownership stays Surface 1.","bank_record_ids":["roles.capability.registry_cpt"]},{"id":"roles.native.tax_caps","api":"register_taxonomy / WP_Taxonomy","member":"taxonomy capability mapping","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/register_taxonomy/","notes":"Taxonomy capability keys are registry inputs; taxonomy definition ownership stays Surface 2.","bank_record_ids":["roles.capability.registry_taxonomy"]},{"id":"roles.native.role_name_check","api":"current_user_can","member":"checking role names instead of capabilities","disposition":"BANK_RECORD","evidence_url":"https://developer.wordpress.org/reference/functions/current_user_can/","notes":"WordPress documents role-name checks as discouraged/unreliable; WPE rejects them as canonical authorization logic.","bank_record_ids":["roles.unsafe.role_name_authorization"]}],"coverage":{"items":20,"bank_record":18,"provider_mapping":0,"system_runtime":2,"out_of_surface":0,"legacy_compatibility":0,"core_internal":0,"unresolved":0}}