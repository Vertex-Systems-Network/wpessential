    {
      "id": "acf.field_sync_storage",
      "provider": "acf",
      "disposition": "IMPLEMENTATION_PATTERN",
      "evidence_url": "https://www.advancedcustomfields.com/resources/bidirectional-relationships/",
      "notes": "ACF stores relationship values in ACF fields on both objects; WPE treats this as a provider compatibility/storage pattern, not its canonical persistent edge store."
    },
    {
      "id": "acf.top_level_nonchain_limits",
      "provider": "acf",
      "disposition": "IMPLEMENTATION_PATTERN",
      "evidence_url": "https://www.advancedcustomfields.com/resources/bidirectional-relationships/",
      "notes": "ACF target fields must be top-level, bidirectional updates do not chain, and reverse-side single/max constraints are not automatically enforced; these are provider behavior limits rather than new WPE relation controls."
    },
    {
      "id": "pods.rest_relationship_field_format",
      "provider": "pods",
      "disposition": "OUT_OF_SURFACE",
      "owner_surface": "fields",
      "evidence_url": "https://docs.pods.io/advanced-topics/rest-api/",
      "notes": "Pods REST read/write/response formatting for a relationship field is field-level API behavior owned by Fields; Relations owns canonical edge APIs and relation-level authorization."
    },
    {
      "id": "acpt.field_sync_storage",
      "provider": "acpt",
      "disposition": "IMPLEMENTATION_PATTERN",
      "evidence_url": "https://docs.acpt.io/meta-fields/field-types/relational-field",
      "notes": "ACPT models relations through relational meta fields and inverse target fields; WPE treats this as provider compatibility rather than canonical relation storage."
