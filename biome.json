{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "admin-ui/src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "recommended": true
      },
      "security": {
        "recommended": true
      },
      "suspicious": {
        "recommended": true
      }
    }
  }
}
